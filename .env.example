# Spring Boot 服务运行
PORT=3000
# single_vendor：单供应商演示/专属部署；proxy_hmac：由 IAM/身份代理签名传入供应商范围
PORTAL_AUTH_MODE=single_vendor
PORTAL_VENDOR_ID=1000000
# PORTAL_AUTH_MODE=proxy_hmac 时必须设置。身份代理使用 HMAC-SHA256(vendorId.timestamp) 生成签名。
# PORTAL_IDENTITY_HMAC_SECRET=replace-me

# SAP 技术用户：由 Java 服务端从 .env 或部署环境读取，切勿加入 git 或浏览器代码
SAP_USERNAME=
SAP_PASSWORD=
# basic 或 bearer
SAP_AUTH_MODE=basic
# SAP_BEARER_TOKEN=

# SAP OData 服务根地址
SAP_BUSINESS_PARTNER_URL=https://my200127-api.s4hana.sapcloud.cn/sap/opu/odata/sap/API_BUSINESS_PARTNER
SAP_PURCHASE_ORDER_URL=https://my200127-api.s4hana.sapcloud.cn/sap/opu/odata4/sap/api_purchaseorder_2/srvd_a2x/sap/purchaseorder/0001/
SAP_ASN_URL=https://my200127-api.s4hana.sapcloud.cn/sap/opu/odata/sap/API_INBOUND_DELIVERY_SRV;v=0002
SAP_MATERIAL_DOCUMENT_URL=https://my200127-api.s4hana.sapcloud.cn/sap/opu/odata/sap/API_MATERIAL_DOCUMENT_SRV
SAP_SUPPLIER_INVOICE_URL=https://my200127-api.s4hana.sapcloud.cn/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV

# 实体集、关联路径与字段由 Portal 按 SAP 标准 API 固定处理，无需在 .env 配置。
# 如租户通过扩展替换了标准 API，请提交 $metadata 后在代码中调整，避免在环境变量中分散配置。
